<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\..\shared\Mmo.Shared\Mmo.Shared.csproj"/>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging" Version="9.0.11"/>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="9.*"/>
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="9.0.11"/>
  </ItemGroup>
  <ItemGroup>
    <None Update="Config\Zones\*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
